# Server settings. On the VPS these live in /etc/chameleon/server.env.
# Local development needs none of them.
HOST=127.0.0.1
PORT=3101
ALLOWED_ORIGINS=https://GAME_DOMAIN
MAX_ROOM_PLAYERS=8
MAX_CONNECTIONS_PER_IP=32
TRUST_PROXY=true
NODE_ENV=production

# Client build. Defaults to same-origin /ws, which is what the VPS setup uses.
# VITE_WS_URL=wss://GAME_DOMAIN/ws
